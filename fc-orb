#!/usr/bin/env bash
# Operator commands for the Firecracker orb runtime.
set -euo pipefail

usage() {
	cat <<'EOF'
Usage: fc-orb <command>

  setup [image]         Build Firecracker, the jailer, the guest kernel, and orb-agent, install
                        them to /opt/fc-orb with sudo, start fc-orbd, and prepare the orb image's
                        disk. Safe to run again after pulling changes.
  install-service       Run `amp orb provider` as a systemd user service that starts at boot
                        and restarts if it exits. Safe to run again after moving this directory.
  list                  List orbs and whether each is running, paused, or stopped.
  exec [--user U] <orb> <script>
                        Run a bash script inside a running orb.
  console <orb>         Print the orb's serial console and Firecracker log.
  pause-all             Snapshot and stop every running orb.
  destroy               Delete ALL orbs, disks, and snapshots, and uninstall the runtime.
EOF
}

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
INSTALL=/opt/fc-orb
ORBCTL="$INSTALL/bin/orbctl"
PROVIDER_SERVICE=fc-orb-provider.service
BUILD_IMAGE=localhost/fc-orb-build

orbctl() { sudo --non-interactive "$ORBCTL" "$@"; }

# What orbctl may receive from the provider's environment. sudo drops every
# other variable.
JOB_VARIABLES="ORB_OPERATION ORB_ID ORB_IMAGE ORB_SNAPSHOT_ID ORB_TYPE ORB_TOKEN AMP_URL \
FC_ORB_VCPUS FC_ORB_MEM_MIB FC_ORB_MEM_RESERVE_MIB FC_ORB_MEM_OVERCOMMIT FC_ORB_DISK_GIB FC_ORB_CPUSET FC_ORB_BOOTSTRAP_CMD"

install_runtime() {
	echo "[fc-orb] building the runtime (the first build compiles the guest kernel, about two minutes)"
	podman build --quiet --tag "$BUILD_IMAGE" "$ROOT/runtime" >/dev/null
	local staging container
	staging="$(mktemp -d)"
	container="$(podman create "$BUILD_IMAGE" /none)"
	mkdir "$staging/out"
	for file in firecracker jailer vmlinux orb-agent; do
		podman cp "$container:/$file" "$staging/out/$file"
	done
	podman rm "$container" >/dev/null

	sudo install -d -m 0755 "$INSTALL" "$INSTALL/bin" "$INSTALL/guest"
	sudo install -m 0755 "$staging/out/firecracker" "$staging/out/jailer" "$ROOT/runtime/orbctl" "$INSTALL/bin/"
	sudo install -m 0644 "$staging/out/vmlinux" "$INSTALL/vmlinux"
	sudo install -m 0755 "$staging/out/orb-agent" "$ROOT/runtime/guest/orb-init" "$INSTALL/guest/"
	sudo install -m 0644 "$ROOT/runtime/guest/orb-agent.service" "$INSTALL/guest/"
	rm -rf "$staging"

	# Lets this user, and so the provider, run orbctl as root without a
	# password, and nothing else.
	local rule
	rule="$(mktemp)"
	cat >"$rule" <<EOF
Defaults!$ORBCTL env_keep += "$JOB_VARIABLES"
$USER ALL=(root) NOPASSWD: $ORBCTL
EOF
	sudo visudo --check --quiet --file "$rule"
	sudo install -m 0440 "$rule" /etc/sudoers.d/fc-orb
	rm -f "$rule"

	# fc-orbd pauses running orbs when it stops, which is how orbs keep their
	# memory across a reboot: orb units are ordered before it, so systemd
	# stops it, and pauses them, before it kills them.
	sudo tee /etc/systemd/system/fc-orbd.service >/dev/null <<EOF
[Unit]
Description=Firecracker orb runtime (pauses running orbs when it stops)
Documentation=file://$ROOT/docs/design.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=$ORBCTL serve
TimeoutStopSec=900
KillMode=process

[Install]
WantedBy=multi-user.target
EOF
	sudo systemctl daemon-reload
	sudo systemctl enable --quiet fc-orbd.service
	# A running fc-orbd only waits for a stop signal, so it can keep running
	# the old code: orbctl is read again for every job.
	sudo systemctl start fc-orbd.service
}

case "${1:-}" in
	setup)
		install_runtime
		orbctl prepare-image "${2:-${ORB_IMAGE:-us-central1-docker.pkg.dev/amp-prod-0/amp-orb/amp-orb:latest}}"
		echo "Runtime ready. Run the provider with: $ROOT/fc-orb install-service"
		;;
	install-service)
		amp="$(command -v amp)" || { echo "amp is not on PATH" >&2; exit 1; }
		unit="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$PROVIDER_SERVICE"
		mkdir -p "$(dirname "$unit")"
		# The provider reads its token from the Amp credentials that
		# `amp orb provider create` saved, so the unit holds no secret.
		# Settings such as FC_ORB_VCPUS go in a drop-in:
		# systemctl --user edit fc-orb-provider
		cat >"$unit" <<EOF
[Unit]
Description=Amp orb provider for Firecracker orbs
Documentation=https://ampcode.com/docs/orbs/self-hosted
# Never give up restarting: at boot the network may not be up yet.
StartLimitIntervalSec=0

[Service]
Type=simple
Environment="PATH=$(dirname "$amp"):/usr/local/bin:/usr/bin:/bin"
ExecStart="$amp" orb provider "$ROOT/dispatch.sh"
Restart=always
RestartSec=5
# On stop the provider waits for its running jobs, so signal only the provider
# and give a job the five minutes Amp allows it.
KillMode=mixed
TimeoutStopSec=300

[Install]
WantedBy=default.target
EOF
		systemctl --user daemon-reload
		systemctl --user enable --quiet "$PROVIDER_SERVICE"
		systemctl --user restart "$PROVIDER_SERVICE"
		echo "Installed and started $unit"
		if [[ "$(loginctl show-user "$USER" --property Linger --value 2>/dev/null)" != yes ]]; then
			echo "It starts when you log in. To start it at boot, run: loginctl enable-linger $USER"
		fi
		;;
	list | pause-all)
		orbctl "$1"
		;;
	exec | console)
		command="$1"
		shift
		orbctl "$command" "$@"
		;;
	destroy)
		orbctl delete-all
		sudo systemctl disable --now --quiet fc-orbd.service || true
		sudo rm -f /etc/systemd/system/fc-orbd.service /etc/sudoers.d/fc-orb
		sudo rm -rf "$INSTALL" /var/lib/fc-orbs
		sudo systemctl daemon-reload
		echo "Removed all orbs, /var/lib/fc-orbs, and $INSTALL."
		;;
	*)
		usage
		exit 1
		;;
esac
