# Options an orb needs on top of Firecracker's guest kernel config
# (resources/guest_configs/microvm-kernel-ci-x86_64-6.18.config and ci.config).
# Each one is here because Docker in an orb reported it missing.

# nftables: dockerd's own rules, and the tables `iptables-nft` and
# `ip6tables-nft` create for it (nat and raw, IPv4 and IPv6).
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_RAW=y

# dockerd deletes a stopped container's connection tracking entries.
CONFIG_NF_CT_NETLINK=y

# Docker's ipvlan and macvlan network drivers.
CONFIG_IPVLAN=y
CONFIG_MACVLAN=y
CONFIG_DUMMY=y
