#!/usr/bin/env python3
"""orbctl runs Amp orbs as Firecracker microVMs.

It runs as root on the host; dispatch.sh calls it through sudo once per Amp
job:

  spawn   boot the orb, or restore it from its memory snapshot, then start
          `amp orb bootstrap` in the guest
  pause   snapshot the guest's memory to disk and exit Firecracker, so a
          sleeping orb uses no CPU or RAM
  delete  remove the orb and its disk

Each orb's Firecracker runs under the jailer, in a transient systemd unit
(fc-orb-<id>.service) that caps its CPU and memory, as its own user, in a
chroot, and in a network namespace of its own.

State lives under /var/lib/fc-orbs:

  images/<image id>/                 base root disk built from an orb image
  snapshots/<key>/                   project snapshots: a prepared orb's root disk
  orbs/<orb id>/                     an orb's config and serial console log
  jail/firecracker/<jail id>/root/   the orb's chroot: its disk, snap/, sockets, fc.log
"""

import argparse
import contextlib
import fcntl
import hashlib
import http.client
import ipaddress
import json
import os
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

STATE = Path("/var/lib/fc-orbs")
JAIL_BASE = STATE / "jail"
INSTALL = Path("/opt/fc-orb")
KERNEL = INSTALL / "vmlinux"
FIRECRACKER = INSTALL / "bin/firecracker"
JAILER = INSTALL / "bin/jailer"
GUEST_FILES = INSTALL / "guest"
AGENT_PORT = 5252  # must match AGENT_PORT in guest/orb-agent.c

# Each orb gets a /30 from this range: the tap end is the guest's gateway.
ORB_NETWORK = ipaddress.ip_network("10.213.0.0/16")
# And a /30 from this one for the veth pair between its namespace and the host.
LINK_NETWORK = ipaddress.ip_network("10.214.0.0/16")
FALLBACK_DNS = ["1.1.1.1", "8.8.8.8"]
# Orb n's Firecracker runs as this UID and GID plus n, clear of the ranges
# that /etc/subuid and LXD hand out.
FIRST_ORB_UID = 300000
# Firecracker's own memory on top of the guest's: page tables, queues, buffers.
VMM_OVERHEAD_MIB = 256

# ORB_TYPE name -> (vCPUs, memory MiB). An unknown or unset type uses
# FC_ORB_VCPUS and FC_ORB_MEM_MIB.
ORB_TYPES = {
    "small": (2, 4096),
    "medium": (4, 8192),
    "large": (8, 16384),
    "xlarge": (16, 32768),
}

DEFAULT_IMAGE = "us-central1-docker.pkg.dev/amp-prod-0/amp-orb/amp-orb:latest"
ORB_ID_PATTERN = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}")
EXIT_TRAILER = re.compile(rb"\n\x1eORB-EXIT (\d+)\n\Z")


def log(message):
    print(f"[fc-orb] {message}", file=sys.stderr, flush=True)


class OrbError(Exception):
    pass


class ApiError(OrbError):
    """Firecracker answered and refused the request, so it had no effect."""


@contextlib.contextmanager
def locked(name):
    lock_dir = STATE / "locks"
    lock_dir.mkdir(parents=True, exist_ok=True)
    with open(lock_dir / f"{name}.lock", "w") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def run(*command):
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0:
        raise OrbError(f"{' '.join(command)}: {result.stderr.strip() or result.stdout.strip()}")
    return result.stdout


def fsync(*paths):
    """Waits until the files or directories at paths are on stable storage.

    A rename or a new file is durable only once its directory is synced, and
    a file's data only once the file is: without both, a power loss can leave
    a name pointing at a file whose contents were never written.
    """
    for path in paths:
        descriptor = os.open(path, os.O_RDONLY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)


def clone_file(source, destination):
    """Copies a disk image; on btrfs or XFS this is a constant-time reflink."""
    temporary = destination.with_name(destination.name + ".tmp")
    run("cp", "--reflink=auto", "--sparse=always", str(source), str(temporary))
    fsync(temporary)
    temporary.rename(destination)
    fsync(destination.parent)


def storage_key(identifier):
    """A directory name for an ID that may hold slashes and colons."""
    digest = hashlib.sha256(identifier.encode()).hexdigest()[:12]
    return re.sub(r"[^A-Za-z0-9._-]", "_", identifier)[:80] + "-" + digest


def disk_gib():
    return int(os.environ.get("FC_ORB_DISK_GIB", "64"))


def image_dir(image_id):
    """The base disk of an orb image as this runtime builds it.

    The disk has a size and holds copies of orb-init and orb-agent, so a
    runtime with another size or newer guest files builds a new disk and
    leaves existing orbs as they are.
    """
    guest_files = hashlib.sha256()
    for path in sorted(GUEST_FILES.iterdir()):
        guest_files.update(path.name.encode() + b"\0" + path.read_bytes())
    name = f"{image_id.removeprefix('sha256:')}-{guest_files.hexdigest()[:12]}-{disk_gib()}g"
    return STATE / "images" / name


def snapshot_dir(snapshot_id):
    return STATE / "snapshots" / storage_key(snapshot_id)


class UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, path, timeout):
        super().__init__("localhost", timeout=timeout)
        self.unix_path = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.unix_path)


class Orb:
    def __init__(self, orb_id):
        if not ORB_ID_PATTERN.fullmatch(orb_id):
            raise OrbError(f"unsupported orb ID: {orb_id!r}")
        self.id = orb_id
        self.dir = STATE / "orbs" / orb_id
        # The jailer takes only letters, digits, and hyphens.
        self.jail_id = re.sub(r"[^A-Za-z0-9-]", "-", orb_id)
        self.unit = f"fc-orb-{self.jail_id}.service"
        # The chroot Firecracker runs in. Paths it is given are relative to
        # this, such as /rootfs.ext4, and must stay the same across restores
        # because a memory snapshot records them.
        self.root = JAIL_BASE / "firecracker" / self.jail_id / "root"
        self.rootfs = self.root / "rootfs.ext4"
        self.api_socket = self.root / "fc.sock"
        self.vsock = self.root / "v.sock"
        self.snap = self.root / "snap"

    # A snapshot may be restored only while this marker exists. The marker is
    # removed before the restored VM runs, because from then on the disk moves
    # ahead of the saved memory and restoring again would corrupt the disk.
    @property
    def snapshot_marker(self):
        return self.snap / "valid"

    @property
    def config(self):
        return json.loads((self.dir / "config.json").read_text())

    @property
    def slot(self):
        return self.config["slot"]

    @property
    def uid(self):
        return FIRST_ORB_UID + self.slot

    @property
    def tap(self):
        return f"orbtap{self.slot}"

    @property
    def netns(self):
        return f"orb{self.slot}"

    @property
    def veth(self):
        """The host end of the veth pair into the orb's namespace."""
        return f"vorb{self.slot}"

    @property
    def link_host_ip(self):
        return LINK_NETWORK.network_address + 4 * self.slot + 1

    @property
    def link_netns_ip(self):
        return LINK_NETWORK.network_address + 4 * self.slot + 2

    @property
    def host_ip(self):
        return ORB_NETWORK.network_address + 4 * self.slot + 1

    @property
    def guest_ip(self):
        return ORB_NETWORK.network_address + 4 * self.slot + 2

    @property
    def guest_mac(self):
        return "06:00:" + ":".join(f"{byte:02x}" for byte in self.guest_ip.packed)

    @property
    def host_mac(self):
        return "06:00:" + ":".join(f"{byte:02x}" for byte in self.host_ip.packed)

    def pid(self):
        """The orb's Firecracker PID, or None when no Firecracker runs for it."""
        try:
            pid = int((self.root / "firecracker.pid").read_text())
            arguments = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
        except (OSError, ValueError):
            return None
        is_ours = arguments[0] == b"/firecracker" and arguments[1:3] == [b"--id", self.jail_id.encode()]
        return pid if is_ours else None

    def api(self, method, path, body=None, timeout=30):
        connection = UnixHTTPConnection(str(self.api_socket), timeout)
        try:
            payload = None if body is None else json.dumps(body)
            connection.request(method, path, body=payload, headers={"Content-Type": "application/json"})
            response = connection.getresponse()
            data = response.read()
        finally:
            connection.close()
        if response.status >= 300:
            raise ApiError(f"Firecracker {method} {path}: {response.status} {data.decode(errors='replace')}")
        return json.loads(data) if data else None

    def run_in_guest(self, script, timeout=60):
        """Runs a bash script as root in the guest; returns (exit code, output)."""
        # Close the descriptor the agent passed the script on, so that what
        # the script starts does not inherit the script text.
        payload = b'exec {ORB_SCRIPT_FD}<&-; unset ORB_SCRIPT_FD\n' + script.encode()
        deadline = time.monotonic() + timeout
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(timeout)
            connection.connect(str(self.vsock))
            connection.sendall(f"CONNECT {AGENT_PORT}\n".encode())
            reply = b""
            while not reply.endswith(b"\n"):
                chunk = connection.recv(1)
                if not chunk:
                    raise ConnectionError("guest agent is not listening")
                reply += chunk
            if not reply.startswith(b"OK "):
                raise ConnectionError(f"vsock handshake failed: {reply!r}")
            connection.sendall(f"{len(payload)}\n".encode() + payload)
            output = b""
            while True:
                connection.settimeout(max(deadline - time.monotonic(), 0.001))
                chunk = connection.recv(65536)
                output += chunk
                trailer = EXIT_TRAILER.search(output)
                if trailer:
                    return int(trailer.group(1)), output[: trailer.start()].decode(errors="replace")
                if not chunk:
                    raise ConnectionError("guest agent closed the connection before the script finished")

    def wait_for_agent(self, timeout=30):
        deadline = time.monotonic() + timeout
        while True:
            try:
                self.run_in_guest(":", timeout=5)
                return
            except OSError as error:
                if self.pid() is None:
                    raise OrbError(f"Firecracker exited during boot; see {self.root}/fc.log") from error
                if time.monotonic() > deadline:
                    raise OrbError(f"guest agent did not answer within {timeout}s; see {self.dir}/console.log") from error
                time.sleep(0.02)


def default_cpuset():
    """The host's performance cores, or None when it has one kind of core.

    Hybrid Intel CPUs list their performance cores in cpu_core. Keeping vCPUs
    off the efficiency cores is what gives an orb the host's best
    single-thread speed.
    """
    try:
        return Path("/sys/devices/cpu_core/cpus").read_text().strip()
    except OSError:
        return None


def give_to_orb(orb, *paths):
    """Hands files in the chroot to the orb's user, which Firecracker runs as."""
    for path in paths:
        os.chown(path, orb.uid, orb.uid)


def link_kernel(orb):
    """Puts the guest kernel in the chroot, as a hard link when it can."""
    target = orb.root / "vmlinux"
    target.unlink(missing_ok=True)
    try:
        os.link(KERNEL, target)
    except OSError:
        shutil.copyfile(KERNEL, target)


def unit_active(orb):
    result = subprocess.run(["systemctl", "is-active", "--quiet", orb.unit])
    return result.returncode == 0


def start_firecracker(orb):
    """Starts the orb's Firecracker under the jailer in a systemd unit.

    The unit caps the orb at the vCPUs and memory it asked for, lets its
    memory go to swap, and makes the OOM killer pick orbs before the
    provider and the desktop (whose processes run at 200). The jailer runs
    Firecracker as the orb's own user, in its chroot and network namespace,
    as PID 1 of a new PID namespace. PID 1 ignores SIGTERM, so the unit stops
    it with SIGKILL; a pause has saved what it needs by then.
    """
    config = orb.config
    orb.root.mkdir(parents=True, exist_ok=True)
    # The jailer makes these on every start and refuses to run if they exist.
    for made in ("dev", "run"):
        shutil.rmtree(orb.root / made, ignore_errors=True)
    for stale in (orb.api_socket, orb.vsock, orb.root / "firecracker.pid", orb.root / "firecracker"):
        stale.unlink(missing_ok=True)
    link_kernel(orb)
    (orb.root / "fc.log").touch()
    give_to_orb(orb, orb.root / "fc.log")
    # A unit that failed earlier would block starting one of the same name.
    subprocess.run(["systemctl", "reset-failed", orb.unit], capture_output=True)
    properties = {
        "Type": "forking",
        "PIDFile": orb.root / "firecracker.pid",
        "KillSignal": "SIGKILL",
        "Slice": "fc-orbs.slice",
        # Stopped after fc-orbd at shutdown, which pauses the orb first.
        "Before": "fc-orbd.service",
        "CPUQuota": f"{config['vcpus'] * 100}%",
        "CPUWeight": config["vcpus"] * 25,
        "MemoryMax": f"{config['memory_mib'] + VMM_OVERHEAD_MIB}M",
        "MemorySwapMax": "infinity",
        "OOMScoreAdjust": 500,
        "StandardOutput": f"append:{orb.dir / 'console.log'}",  # the guest's serial console
        "StandardError": f"append:{orb.dir / 'console.log'}",
    }
    cpus = os.environ.get("FC_ORB_CPUSET") or default_cpuset()
    if cpus:
        properties["AllowedCPUs"] = cpus
    run(
        "systemd-run", "--quiet", "--collect", "--unit", orb.unit,
        *(f"--property={name}={value}" for name, value in properties.items()),
        str(JAILER),
        "--id", orb.jail_id,
        "--exec-file", str(FIRECRACKER),
        "--uid", str(orb.uid), "--gid", str(orb.uid),
        "--chroot-base-dir", str(JAIL_BASE),
        "--netns", f"/run/netns/{orb.netns}",
        "--cgroup-version", "2",  # with no --cgroup, the unit's cgroup is used
        "--new-pid-ns",
        "--",
        "--api-sock", "/fc.sock",
        "--log-path", "/fc.log",  # otherwise its log mixes into the console
        "--level", "Info",
    )
    deadline = time.monotonic() + 10
    while True:
        try:
            orb.api("GET", "/")
            return
        except OSError as error:
            if time.monotonic() > deadline or (orb.pid() is None and not unit_active(orb)):
                raise OrbError(
                    f"Firecracker did not start; see `journalctl -u {orb.unit}` and {orb.root}/fc.log"
                ) from error
            time.sleep(0.005)


def stop_firecracker(orb):
    if orb.pid() is None and not unit_active(orb):
        return
    subprocess.run(["systemctl", "kill", "--signal=SIGKILL", orb.unit], capture_output=True)
    deadline = time.monotonic() + 10
    while orb.pid() is not None or unit_active(orb):
        if time.monotonic() > deadline:
            raise OrbError(f"{orb.unit} did not stop")
        time.sleep(0.01)


# Replaced whole on every spawn, so a newer runtime's rules take effect.
FIREWALL = f"""
table inet fc_orbs
delete table inet fc_orbs
table inet fc_orbs {{
    chain forward {{
        type filter hook forward priority filter; policy accept;
        # One orb cannot reach another.
        iifname "vorb*" oifname "vorb*" drop
    }}
    chain input {{
        type filter hook input priority filter; policy accept;
        # Nor the host itself, except for replies to what the host sent.
        iifname "vorb*" ct state established,related accept
        iifname "vorb*" drop
    }}
    chain postrouting {{
        type nat hook postrouting priority srcnat; policy accept;
        # Orbs reach the outside through the host's own address.
        ip saddr {ORB_NETWORK} oifname != "vorb*" masquerade
    }}
}}
"""


def ensure_network(orb):
    """Gives the orb a network namespace with its tap device, routed to the host.

    The guest's gateway is the tap, inside the namespace. A veth pair joins
    the namespace to the host, which routes the orb's /30 to it and NATs the
    orb's traffic out.
    """
    netns = ("ip", "-n", orb.netns)
    if not Path(f"/run/netns/{orb.netns}").exists():
        run("ip", "netns", "add", orb.netns)
    run("ip", "netns", "exec", orb.netns, "sysctl", "-qw", "net.ipv4.ip_forward=1")
    run(*netns, "link", "set", "lo", "up")
    if not Path(f"/sys/class/net/{orb.veth}").exists():
        run("ip", "link", "add", orb.veth, "type", "veth", "peer", "name", "veth0", "netns", orb.netns)
    run("ip", "addr", "replace", f"{orb.link_host_ip}/30", "dev", orb.veth)
    run("ip", "link", "set", orb.veth, "up")
    run(*netns, "addr", "replace", f"{orb.link_netns_ip}/30", "dev", "veth0")
    run(*netns, "link", "set", "veth0", "up")
    run(*netns, "route", "replace", "default", "via", str(orb.link_host_ip))
    if subprocess.run([*netns, "link", "show", orb.tap], capture_output=True).returncode != 0:
        # Owned by the orb's user, so Firecracker can attach to it unprivileged.
        run(*netns, "tuntap", "add", "dev", orb.tap, "mode", "tap", "user", str(orb.uid), "group", str(orb.uid))
        # A restored guest still has its gateway's MAC address cached, so a
        # recreated tap must come back with the same one or the guest's
        # packets are dropped until that cache entry expires.
        run(*netns, "link", "set", "dev", orb.tap, "address", orb.host_mac)
    run(*netns, "addr", "replace", f"{orb.host_ip}/30", "dev", orb.tap)
    run(*netns, "link", "set", orb.tap, "up")
    run("ip", "route", "replace", f"{orb.host_ip - 1}/30", "via", str(orb.link_netns_ip), "dev", orb.veth)
    with locked("network"):
        result = subprocess.run(["nft", "-f", "-"], input=FIREWALL, text=True, capture_output=True)
        if result.returncode != 0:
            raise OrbError(f"nft: {result.stderr.strip()}")


def remove_network(orb):
    """Deletes the namespace, which takes the tap, the veth pair, and the route."""
    if Path(f"/run/netns/{orb.netns}").exists():
        run("ip", "netns", "del", orb.netns)


def allocate_slot():
    used = set()
    for config in (STATE / "orbs").glob("*/config.json"):
        with contextlib.suppress(OSError, ValueError, KeyError):
            used.add(json.loads(config.read_text())["slot"])
    limit = ORB_NETWORK.num_addresses // 4
    return next(slot for slot in range(limit) if slot not in used)


def create(orb):
    """Gives a new orb its disk: a project snapshot if we have it, else the image."""
    snapshot_id = os.environ.get("ORB_SNAPSHOT_ID", "")
    if snapshot_id and (snapshot_dir(snapshot_id) / "rootfs.ext4").exists():
        source = snapshot_dir(snapshot_id)
        log(f"creating {orb.id} from project snapshot {snapshot_id}")
    else:
        image = os.environ.get("ORB_IMAGE") or DEFAULT_IMAGE
        image_id = ensure_image(image)
        source = image_dir(image_id)
        log(f"creating {orb.id} from image {image_id[:12]}")

    vcpus, memory_mib = ORB_TYPES.get(
        os.environ.get("ORB_TYPE", ""),
        (int(os.environ.get("FC_ORB_VCPUS", "4")), int(os.environ.get("FC_ORB_MEM_MIB", "8192"))),
    )
    orb.dir.mkdir(parents=True, exist_ok=True)
    with locked("slots"):
        config = {
            "image": json.loads((source / "image.json").read_text()),
            "vcpus": vcpus,
            "memory_mib": memory_mib,
            "slot": allocate_slot(),
        }
        (orb.dir / "config.json").write_text(json.dumps(config, indent=2))
    orb.root.mkdir(parents=True, exist_ok=True)
    clone_file(source / "rootfs.ext4", orb.rootfs)
    give_to_orb(orb, orb.rootfs)


def in_jail(orb, path):
    """A path in the orb's chroot as its Firecracker sees it."""
    return "/" + str(path.relative_to(orb.root))


def cold_boot(orb):
    config = orb.config
    for stale in (orb.snap, orb.root / "snap.new"):
        shutil.rmtree(stale, ignore_errors=True)
    ensure_network(orb)
    start_firecracker(orb)
    boot_args = (
        "console=ttyS0 reboot=k panic=1 quiet loglevel=4 random.trust_cpu=on init=/sbin/orb-init "
        # Nothing reads the serial console, so systemd need not offer a login on it.
        "systemd.mask=serial-getty@ttyS0.service "
        f"ip={orb.guest_ip}::{orb.host_ip}:255.255.255.252:{orb.id}:eth0:off"
    )
    orb.api("PUT", "/machine-config", {"vcpu_count": config["vcpus"], "mem_size_mib": config["memory_mib"]})
    orb.api("PUT", "/boot-source", {"kernel_image_path": "/vmlinux", "boot_args": boot_args})
    orb.api(
        "PUT",
        "/drives/rootfs",
        {
            "drive_id": "rootfs",
            "path_on_host": in_jail(orb, orb.rootfs),
            "is_root_device": True,
            "is_read_only": False,
            # Honor the guest's flushes, so its filesystem survives a host crash.
            "cache_type": "Writeback",
        },
    )
    orb.api(
        "PUT",
        "/network-interfaces/eth0",
        {"iface_id": "eth0", "host_dev_name": orb.tap, "guest_mac": orb.guest_mac},
    )
    orb.api("PUT", "/vsock", {"guest_cid": 3, "uds_path": in_jail(orb, orb.vsock)})
    orb.api("PUT", "/entropy", {})
    # The guest reports memory it frees, and Firecracker hands it back to the
    # host. Without this, an orb keeps every page it ever touched until it
    # pauses, and its snapshot keeps them too.
    orb.api(
        "PUT",
        "/balloon",
        {"amount_mib": 0, "deflate_on_oom": False, "stats_polling_interval_s": 0, "free_page_reporting": True},
    )
    orb.api("PUT", "/actions", {"action_type": "InstanceStart"})
    orb.wait_for_agent()


def restore(orb):
    """Resumes the orb from its memory snapshot. Returns False if that failed."""
    # If the marker came back after a power loss, the guest's disk writes
    # from this run would be under a memory snapshot that predates them.
    orb.snapshot_marker.unlink()
    fsync(orb.snap)
    try:
        ensure_network(orb)
        start_firecracker(orb)
        orb.api(
            "PUT",
            "/snapshot/load",
            {
                "snapshot_path": in_jail(orb, orb.snap / "vmstate"),
                "mem_backend": {"backend_type": "File", "backend_path": in_jail(orb, orb.snap / "mem")},
                "resume_vm": True,
            },
            timeout=60,
        )
        orb.wait_for_agent()
        return True
    except (OrbError, OSError) as error:
        # The guest may have run, so the snapshot is no longer safe to load.
        # Its disk is intact: boot from that, as after a power loss.
        log(f"could not restore {orb.id} from its memory snapshot ({error}); booting from disk instead")
        stop_firecracker(orb)
        return False


def prepare_guest(orb):
    """Sets what a restored guest cannot know: the time and the host's DNS."""
    nameservers = []
    # With systemd-resolved, /etc/resolv.conf names its stub on loopback, and
    # this file lists the upstream servers behind it.
    upstream = Path("/run/systemd/resolve/resolv.conf")
    for line in (upstream if upstream.exists() else Path("/etc/resolv.conf")).read_text().splitlines():
        fields = line.split()
        if len(fields) < 2 or fields[0] != "nameserver":
            continue
        with contextlib.suppress(ValueError):
            address = ipaddress.ip_address(fields[1])
            # The guest has no IPv6 and cannot reach the host's loopback.
            if address.version == 4 and not address.is_loopback:
                nameservers.append(fields[1])
    resolv_conf = "".join(f"nameserver {server}\n" for server in nameservers or FALLBACK_DNS)
    hosts = f"127.0.0.1 localhost\n::1 localhost ip6-localhost ip6-loopback\n127.0.1.1 {orb.id}\n"
    # A restored guest's clock still shows the time it was paused at, which
    # breaks TLS and token checks until it is set.
    script = f"""
date -u -s @{time.time():.3f} >/dev/null
hostname {shlex.quote(orb.id)}
printf %s {shlex.quote(resolv_conf)} >/etc/resolv.conf
printf %s {shlex.quote(hosts)} >/etc/hosts
"""
    code, output = orb.run_in_guest(script)
    if code != 0:
        raise OrbError(f"preparing the guest failed ({code}): {output.strip()}")


def bootstrap(orb):
    """Starts `amp orb bootstrap` the way `docker exec -d` would for the image."""
    image = orb.config["image"]
    user = (image.get("User") or "root").split(":")[0]
    environment = dict(entry.split("=", 1) for entry in image.get("Env") or [])
    for name in ("ORB_TOKEN", "AMP_URL"):
        if os.environ.get(name):
            environment[name] = os.environ[name]
    exports = "\n".join(f"export {name}={shlex.quote(value)}" for name, value in environment.items())
    command = os.environ.get("FC_ORB_BOOTSTRAP_CMD") or "amp orb bootstrap"
    script = f"""
user={shlex.quote(user)}
cd {shlex.quote(image.get("WorkingDir") or "/")} || exit 1
{exports}
export HOME="$(getent passwd "$user" | cut -d: -f6)" USER="$user" LOGNAME="$user"
log=/var/log/orb-bootstrap.log
setsid setpriv --reuid="$user" --regid="$(id -g "$user")" --init-groups -- \\
    bash -c {shlex.quote(command)} </dev/null >>"$log" 2>&1 &
sleep 0.3
if ! kill -0 $! 2>/dev/null && ! wait $!; then
    echo "bootstrap command exited early; last lines of $log:"
    tail -n 20 "$log"
    exit 1
fi
"""
    code, output = orb.run_in_guest(script)
    if code != 0:
        raise OrbError(f"starting the bootstrap in {orb.id} failed: {output.strip()}")


def meminfo():
    """The host's /proc/meminfo in MiB; a container sees the host's values."""
    fields = {}
    for line in Path("/proc/meminfo").read_text().splitlines():
        name, value = line.split(":", 1)
        fields[name] = int(value.split()[0]) // 1024
    return fields


def written_mib(pid):
    """Guest memory a Firecracker process holds on the host: what the guest
    has written. Pages a restored guest only read stay in the page cache."""
    status = Path(f"/proc/{pid}/status").read_text()
    return int(re.search(r"^RssAnon:\s+(\d+)", status, re.M).group(1)) // 1024


def admit(orb):
    """Refuses to start an orb unless the host can hold all of its memory.

    A running orb can grow to its full size at any time, even after handing
    memory back: what it does not hold now (Firecracker's anonymous memory)
    is counted as taken. Starting orbs past that point would let the host's OOM
    killer pick an orb, the provider, or dockerd once they grow.
    """
    host = meminfo()
    reserve = int(os.environ.get("FC_ORB_MEM_RESERVE_MIB") or host["MemTotal"] // 10)
    growth = 0
    for other in all_orbs():
        pid = other.pid()
        if pid is None or other.id == orb.id:
            continue
        with contextlib.suppress(OSError, ValueError):
            growth += max(other.config["memory_mib"] - written_mib(pid), 0)
    needed = orb.config["memory_mib"]
    if needed + growth + reserve > host["MemAvailable"]:
        raise OrbError(
            f"not enough host memory to start {orb.id}: it needs {needed} MiB and running orbs can still grow by "
            f"{growth} MiB, but the host has {host['MemAvailable']} MiB available and keeps {reserve} MiB for "
            "itself (FC_ORB_MEM_RESERVE_MIB). Archive threads you are done with, or wait for idle orbs to pause."
        )


def spawn(orb):
    started = time.monotonic()
    if orb.pid() is not None:
        orb.api("PATCH", "/vm", {"state": "Resumed"})  # in case a pause was interrupted
        how = "was already running"
    else:
        if not orb.rootfs.exists():
            create(orb)
        # Held until Firecracker runs, so concurrent spawns each count the
        # orbs the others start.
        with locked("memory"):
            admit(orb)
            if orb.snapshot_marker.exists() and restore(orb):
                how = "restored from memory snapshot"
            else:
                cold_boot(orb)
                how = "booted from disk"
    prepare_guest(orb)
    bootstrap(orb)
    config = orb.config
    log(
        f"{orb.id} {how} in {time.monotonic() - started:.2f}s "
        f"({config['vcpus']} vCPUs, {config['memory_mib']} MiB)"
    )


def save_project_snapshot(orb, snapshot_id):
    target = snapshot_dir(snapshot_id)
    staging = target.with_name(target.name + ".tmp")
    with locked("snapshots"):
        shutil.rmtree(staging, ignore_errors=True)
        staging.mkdir(parents=True)
        clone_file(orb.rootfs, staging / "rootfs.ext4")
        (staging / "image.json").write_text(json.dumps(orb.config["image"]))
        fsync(staging / "image.json", staging)
        shutil.rmtree(target, ignore_errors=True)
        staging.rename(target)
        fsync(target.parent)
    log(f"saved project snapshot {snapshot_id} from {orb.id}")


def make_durable(orb, snapshot):
    """Makes a new memory snapshot and the disk it belongs with durable, then
    marks the snapshot restorable.

    Firecracker writes all of the guest's memory, mostly zeros for an orb that
    used a fraction of it. Punching those out before the data is written back
    keeps a sleeping orb's footprint, and the time to pause it, proportional
    to the memory it used.

    The guest's last disk writes may still be in the host's page cache, and
    the marker must not reach the disk before them or before the memory: a
    power loss would then leave a snapshot that restores over a disk older
    than its memory, which corrupts the guest's filesystem.
    """
    subprocess.run(["fallocate", "--dig-holes", str(snapshot / "mem")], capture_output=True)
    fsync(snapshot / "mem", snapshot / "vmstate", orb.rootfs)
    (snapshot / "valid").touch()
    fsync(snapshot)


def pause(orb):
    started = time.monotonic()
    if orb.pid() is not None:
        # Flush the guest's page cache, so the disk alone (a project snapshot,
        # or a boot after a failed restore) holds everything written so far.
        with contextlib.suppress(OSError, OrbError):
            orb.run_in_guest("sync", timeout=60)
        staging = orb.root / "snap.new"
        shutil.rmtree(staging, ignore_errors=True)
        staging.mkdir()
        give_to_orb(orb, staging)  # Firecracker writes the snapshot as the orb's user
        try:
            orb.api("PATCH", "/vm", {"state": "Paused"})
            # The running guest still reads its previous memory file, so the
            # new snapshot goes next to it and replaces it once Firecracker
            # has exited.
            orb.api(
                "PUT",
                "/snapshot/create",
                {
                    "snapshot_type": "Full",
                    "snapshot_path": in_jail(orb, staging / "vmstate"),
                    "mem_file_path": in_jail(orb, staging / "mem"),
                    # Synced below, after the unused pages are dropped.
                    "sync_snapshot_files": False,
                },
                timeout=270,
            )
            stop_firecracker(orb)
            make_durable(orb, staging)
            saved = True
        except (OrbError, OSError) as error:
            log(f"could not snapshot {orb.id} ({error}); stopping it with its disk only")
            stop_firecracker(orb)
            saved = False
        shutil.rmtree(orb.snap, ignore_errors=True)
        if saved:
            staging.rename(orb.snap)
            fsync(orb.root)
            size_mib = (orb.snap / "mem").stat().st_blocks * 512 // 2**20
            log(f"{orb.id} paused in {time.monotonic() - started:.2f}s ({size_mib} MiB of memory saved)")
        else:
            shutil.rmtree(staging, ignore_errors=True)
        remove_network(orb)
    snapshot_id = os.environ.get("ORB_SNAPSHOT_ID", "")
    if snapshot_id and orb.rootfs.exists():
        save_project_snapshot(orb, snapshot_id)


def delete(orb):
    stop_firecracker(orb)
    if (orb.dir / "config.json").exists():
        remove_network(orb)
    shutil.rmtree(orb.root.parent, ignore_errors=True)
    shutil.rmtree(orb.dir, ignore_errors=True)
    log(f"{orb.id} deleted")


def state_of(orb):
    if orb.pid() is not None:
        return "running"
    if orb.snapshot_marker.exists():
        return "paused"
    return "stopped"


def all_orbs():
    return [Orb(path.parent.name) for path in sorted((STATE / "orbs").glob("*/config.json"))]


def command_job(arguments):
    orb = Orb(os.environ["ORB_ID"])
    with locked(orb.id):
        {"spawn": spawn, "pause": pause, "delete": delete}[arguments.command](orb)


def ensure_image(image):
    """Returns the ID of an orb image's base disk, building the disk on first use.

    Pulls the image with Podman only when the host does not have it, so an
    image is never updated behind existing orbs; `podman pull` updates it.
    """
    with locked("images"):
        if subprocess.run(["podman", "image", "exists", image]).returncode != 0:
            log(f"pulling {image}")
            run("podman", "pull", "--quiet", image)
        image_id = run("podman", "image", "inspect", "--format", "{{.Id}}", image).strip()
        if not (image_dir(image_id) / "rootfs.ext4").exists():
            log(f"building a root disk from {image} (once per image, about a minute)")
            image_config = run("podman", "image", "inspect", "--format", "{{json .Config}}", image)
            container = run("podman", "create", image).strip()
            try:
                export = subprocess.Popen(["podman", "export", container], stdout=subprocess.PIPE)
                import_image(image_id, image_config, export.stdout)
                if export.wait() != 0:
                    raise OrbError(f"podman export of {image} failed")
            finally:
                subprocess.run(["podman", "rm", "--force", container], capture_output=True)
        return image_id


def import_image(image_id, image_config, stream):
    """Builds a base root disk from the files of an exported container."""
    target = image_dir(image_id)
    if (target / "rootfs.ext4").exists():
        return
    staging = target.with_name(target.name + ".tmp")
    shutil.rmtree(staging, ignore_errors=True)
    root = staging / "root"
    root.mkdir(parents=True)
    subprocess.run(["tar", "-x", "-p", "--numeric-owner", "-C", str(root)], stdin=stream, check=True)

    for marker in (".dockerenv", "run/.containerenv"):
        (root / marker).unlink(missing_ok=True)
    guest_files = [("orb-init", "sbin/orb-init", 0o755), ("orb-agent", "usr/local/sbin/orb-agent", 0o755)]
    # `sbin` and `lib` are symlinks into `usr` in current images, so test the
    # path a symlink in the image cannot redirect outside it.
    has_systemd = (root / "usr/lib/systemd/systemd").exists()
    if has_systemd:
        guest_files.append(("orb-agent.service", "etc/systemd/system/orb-agent.service", 0o644))
    for source, destination, mode in guest_files:
        path = root / "usr" / destination if (root / destination.split("/")[0]).is_symlink() else root / destination
        path.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(GUEST_FILES / source, path)
        path.chmod(mode)
    if has_systemd:
        wants = root / "etc/systemd/system/multi-user.target.wants"
        wants.mkdir(parents=True, exist_ok=True)
        enabled = wants / "orb-agent.service"
        enabled.unlink(missing_ok=True)
        enabled.symlink_to("/etc/systemd/system/orb-agent.service")

    disk = staging / "rootfs.ext4"
    with open(disk, "wb") as handle:
        handle.truncate(disk_gib() * 2**30)
    run("mkfs.ext4", "-q", "-F", "-L", "orbroot", "-m", "0", "-d", str(root), str(disk))
    shutil.rmtree(root)
    (staging / "image.json").write_text(image_config)
    fsync(disk, staging / "image.json", staging)
    shutil.rmtree(target, ignore_errors=True)
    staging.rename(target)
    fsync(target.parent)
    log(f"imported image {image_id[:12]} as a {disk_gib()} GiB root disk")


def command_console(arguments):
    orb = Orb(arguments.orb_id)
    for path in (orb.dir / "console.log", orb.root / "fc.log"):
        with contextlib.suppress(FileNotFoundError):
            sys.stdout.write(path.read_text(errors="replace"))


def command_list(arguments):
    print(f"{'ORB':<42} {'STATE':<8} {'VCPUS':>5} {'MEM':>7}  GUEST IP")
    for orb in all_orbs():
        config = orb.config
        print(f"{orb.id:<42} {state_of(orb):<8} {config['vcpus']:>5} {config['memory_mib']:>6}M  {orb.guest_ip}")


def command_exec(arguments):
    orb = Orb(arguments.orb_id)
    if orb.pid() is None:
        raise OrbError(f"{orb.id} is not running")
    script = arguments.script
    if arguments.user:
        user = shlex.quote(arguments.user)
        script = (
            f'cd "$(getent passwd {user} | cut -d: -f6)" && export HOME="$PWD" USER={user} && '
            f"exec setpriv --reuid={user} --regid=$(id -g {user}) --init-groups -- bash -c {shlex.quote(script)}"
        )
    code, output = orb.run_in_guest(script, timeout=arguments.timeout)
    sys.stdout.write(output)
    sys.exit(code)


def pause_all():
    # One at a time: pauses are bound by the disk, so four at once took as
    # long in total as four in a row, and each took four times as long.
    for orb in all_orbs():
        with locked(orb.id):
            if orb.pid() is not None:
                try:
                    pause(orb)
                except (OrbError, OSError) as error:
                    log(f"pausing {orb.id} failed: {error}")


def command_pause_all(arguments):
    pause_all()


def command_delete_all(arguments):
    for orb in all_orbs():
        with locked(orb.id):
            delete(orb)


def command_serve(arguments):
    """fc-orbd's main process: when the service stops, snapshots running orbs.

    Orb units are ordered before fc-orbd.service, so at shutdown systemd
    stops this first, and every orb is paused before its unit is killed.
    """

    def stop(signal_number, frame):
        log("fc-orbd stopping; pausing running orbs")
        pause_all()
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    for directory in ("orbs", "images", "snapshots", "jail"):
        (STATE / directory).mkdir(parents=True, exist_ok=True)
    log("runtime ready")
    while True:
        signal.pause()


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("spawn", "pause", "delete"):
        commands.add_parser(name, help=f"run the Amp {name} job for $ORB_ID").set_defaults(run=command_job)
    prepare = commands.add_parser("prepare-image", help="pull an orb image and build its base disk")
    prepare.add_argument("image", nargs="?", default=DEFAULT_IMAGE)
    prepare.set_defaults(run=lambda arguments: ensure_image(arguments.image))
    commands.add_parser("list", help="list orbs and their state").set_defaults(run=command_list)
    exec_parser = commands.add_parser("exec", help="run a bash script in a running orb")
    exec_parser.add_argument("--user", help="run as this user instead of root")
    exec_parser.add_argument("--timeout", type=float, default=600)
    exec_parser.add_argument("orb_id")
    exec_parser.add_argument("script")
    exec_parser.set_defaults(run=command_exec)
    console = commands.add_parser("console", help="print an orb's serial console and Firecracker log")
    console.add_argument("orb_id")
    console.set_defaults(run=command_console)
    commands.add_parser("pause-all", help="pause every running orb").set_defaults(run=command_pause_all)
    commands.add_parser("delete-all", help="delete every orb and its disk").set_defaults(run=command_delete_all)
    commands.add_parser("serve", help="fc-orbd's main process").set_defaults(run=command_serve)

    arguments = parser.parse_args()
    try:
        arguments.run(arguments)
    except OrbError as error:
        log(f"error: {error}")
        sys.exit(1)


if __name__ == "__main__":
    main()
